# 换行符统一：多人协作时避免整文件"被改了一遍"的假 diff。
# 检出时一律 LF；Windows 上的编辑器请配置为 LF。
* text=auto eol=lf

# 明确声明为二进制，避免 Git 尝试做文本转换 / 行尾处理
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.psd   binary
*.aseprite binary
*.ogg   binary
*.wav   binary
*.mp3   binary
*.ttf   binary
*.otf   binary

# 锁文件与生成物：合并时不要逐行比对，冲突时以一侧为准
*.lock  -diff merge=binary

# Godot 文本资源：显式钉成 LF。Godot 在 Windows 上会写 CRLF，
# 不清除的话异地双人每次保存都会产生"整文件被改了一遍"的假 diff。
*.gd    text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf
*.godot text eol=lf
